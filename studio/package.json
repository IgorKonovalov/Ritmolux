{
  "name": "ritmolux-studio",
  "version": "0.147.0",
  "private": true,
  "description": "The Ritmolux studio: an Electron shell that edits a preset by driving the player.",
  "author": "Igor Konovalov",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"main,preload,vite,electron\" -c \"yellow,magenta,cyan,green\" \"node scripts/build-main.mjs --watch\" \"node scripts/build-preload.mjs --watch\" \"vite\" \"wait-on http://localhost:5273 file:dist/main/index.cjs file:dist/preload/index.cjs && cross-env ELECTRON_RENDERER_URL=http://localhost:5273 electron .\"",
    "build:main": "node scripts/build-main.mjs",
    "build:preload": "node scripts/build-preload.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "electron .",
    "package:win": "electron-builder --win --dir",
    "package:mac": "electron-builder --mac --universal --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"electron/**/*.ts\" \"renderer/**/*.{ts,tsx}\" \"shared/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit --project tsconfig.main.json && tsc --noEmit --project tsconfig.preload.json && tsc --noEmit --project tsconfig.renderer.json && tsc --noEmit --project tsconfig.test.json"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "32.1.2",
    "electron-builder": "25.1.8",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.8",
    "typescript": "5.6.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wait-on": "9.1.0"
  },
  "allowScripts": {
    "electron@32.1.2": true,
    "esbuild@0.28.2": true
  }
}
