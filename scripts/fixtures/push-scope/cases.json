  ],
  "base": [
    "README.md",
    "Cargo.toml",
    "Cargo.lock",
    "core/src/lib.rs",
    "docs/plans/README.md",
    "presets/aurora.toml"
  ],
  "ranges": [
    {
      "name": "docs-only",
      "write": ["docs/plans/0999-a-plan.md", "docs/adrs/0999-an-adr.md", "README.md"],
      "expect": "none"
    },
    {
      "name": "preset-only",
      "write": ["presets/x.toml"],
      "expect": "match",
      "path": "presets/x.toml"
    },
    {
      "name": "lockfile-only",
      "write": ["Cargo.lock"],
      "expect": "match",
      "path": "Cargo.lock"
    },
    {
      "name": "no-common-ancestor",
      "write": ["docs/plans/README.md"],
      "orphan": true,
      "expect": "match",
      "reason": "no common ancestor"
    },
    {
      "name": "one-rs-file",
      "write": ["core/src/extra.rs"],
      "expect": "match",
      "path": "core/src/extra.rs"
    },
    {
      "name": "rs-file-deleted",
      "delete": ["core/src/lib.rs"],
      "expect": "match",
      "path": "core/src/lib.rs"
    },
    {
      "name": "docs-a-test-reads",
      "write": ["docs/plans/0998-another.md", "docs/configuration.md"],
      "expect": "match",
      "path": "docs/configuration.md"
    },
    {
      "name": "empty-commit",
      "expect": "none"
    }
  ]
}
