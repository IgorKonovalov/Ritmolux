    { "path": "docs/configuration.md", "expect": "match" },
    { "path": "docs/examples/tuning/step1.toml", "expect": "match" },
    { "path": "docs/plans/0213-the-hook-costs-what-the-push-is-worth.md", "expect": "none" },
    { "path": "docs/adrs/README.md", "expect": "none" },
