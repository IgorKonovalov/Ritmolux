#!/bin/sh
# Pre-push gate (Plan 0032 Phase 3, ADR-0033).
#
# Runs the fast subset of what CI runs, so a broken push costs seconds here
# instead of minutes there. Stops at the first failure and names the step.
#
# NOT run here, by design (ADR-0033 Alternative F): `cargo deny`, doctests,
# Miri, and the coverage job. Those push the gate from tens of seconds into
# minutes, and a gate that hurts gets disabled — at which point it is worth less
# than the fast subset it replaced. They are also the checks least likely to
# break from a local edit. CI runs all of them.
#
# Install (per clone — git will not run a hook from a tracked directory
# without this, so an uninstalled clone silently has no gate):
#
#     git config core.hooksPath .githooks
#
# Bypass once:  git push --no-verify
#
# POSIX sh: runs under Git-for-Windows' bundled shell and macOS sh alike.

set -u

# Suites excluded from the hook's test step, chosen by measurement rather than
# by guess. Warm wall times on the development machine: reactivity 89 s,
# animation 73 s, sanity 46 s, distinctness 41 s, reaction_diffusion 54 s,
# attractor 49 s, golden 25 s. They iterate every shipped preset or scene
# through a real GPU, which is what makes them slow and what makes them CI's
# job. Excluding them takes the gate from ~98 s to ~27 s warm.
#
# WHICH nine they are is no longer written here. Since ADR-0156 the list is the
# `fast` profile's default-filter in .config/nextest.toml, and this hook, CI's
# `check` job and the `dev` lane's per-phase gate all cite `-P fast`. The
# measured reasoning above stays in this file and is deliberately not copied
# into the toml; only the list moved. Adding or removing a suite is now a
# one-file edit that none of the three consumers can fall out of step on.
#
# CI still runs all of it on every push, but since ADR-0073 it runs these nine
# in ONE job rather than two: `check (windows-latest)` now carries the same
# exclusion this hook does, and `coverage` is the only place they execute on
# Windows. So skipping them locally still costs nothing — but that promise is
# now underwritten by a single CI job rather than by a redundancy between two.
fail() {
    echo ""
    echo "pre-push: FAILED at: $1"
    echo "pre-push: fix it, or bypass this gate with: git push --no-verify"
    exit 1
}

run_step() {
    label="$1"
    shift
    echo "pre-push: $label"
    "$@" || fail "$label"
}

echo "pre-push: running the fast subset (doc links, backlog claims, comment hygiene, sd-filter, fmt, clippy, tests)"

# Cheapest check first, so the cheapest failure is the fastest one. ~50 ms, which
# is why it fits a gate ADR-0033 Alternative F otherwise keeps to the fast subset:
# the budget argument that excludes `cargo deny` and Miri does not reach it.
#
# It is here rather than only in the architect close ceremony because the moment
# a link breaks is a push, not a close: moving a plan into docs/plans/done/
# invalidates every inbound link naming its old path and every `../adrs/` link
# inside it. That went unnoticed across six consecutive closes (74 broken links
# by Plan 0060) precisely because nothing ran at push time.
#
# Node is not otherwise required to build or test this project, so an absent node
# SKIPS with a notice rather than failing the push — the ADR-0016 shape. That is
# a statement about this HOOK, not about the gate: the `links` job in CI runs the
# same check on ubuntu-latest, where Node is always present and it cannot skip.
#
# The backlog-claim gate rides the same guard (Plan 0093 Phase 3, ADR-0108). It
# re-runs the probes docs/design-backlog.md's live entries carry beside their
# claims about this repo — four entries had been falsified and three of those
# carried no verification stamp at all, so a stale entry sends the next reader
# to do work that is already done. Same cost class as the link check: a parse of
# one markdown file plus a bounded number of regex scans.
#
# The filter-figure gate rides it too (Plan 0106 Phase 7e, ADR-0120). It asserts
# that the diffusion filter's cost figures live in docs/diffusion-filter.md and
# nowhere else. Same cost class as the three beside it, and the same history: the
# feature was documented in three files at once, and a correction at Plan 0106's
# close enumerated two of the three copies and missed the third. It checks that
# duplicates do not EXIST rather than that they agree, because the copy that broke
# it was the one outside the list anyone was checking.
#
# The comment-hygiene gate rides it too (Plan 0118 Phase 5, ADR-0127). It rejects
# a relative link in a `.rs` comment and plan-relative narration - the two rot
# classes a script can judge. The links are the reason it is here rather than in
# the close ceremony alone: `check-doc-links.mjs` walks `.md` only, so eleven `.rs`
# links were broken on main with every gate green, and they break at exactly the
# moment a plan moves into docs/plans/done/. Same cost class as the three beside
# it. It says nothing about how LONG a comment is - that judgement is the Mode 4
# review's, per ADR-0127.
#
# The index-row gate rides it too (Plan 0105 Phase 5, ADR-0116). It holds every
# row inside a marked roster region to 320 bytes, because the three index files
# had grown rows that summarize the documents they point at — docs/adrs/README.md
# reached 16 % of the ADR corpus it indexes. Push time is the right moment for the
# same reason the link check is here: the close ceremony writes these rows, and a
# convention alone has already been tried and already failed (Plan 0061 Phase 7b
# archived the plan write-ups, and the section regrew 7.1x in eight days under its
# own "One line per plan" heading). Same cost class again — a walk of the markdown
# tree and a byte count per row.
if command -v node >/dev/null 2>&1; then
    run_step "node scripts/check-doc-links.mjs" node scripts/check-doc-links.mjs
    run_step "node scripts/check-index-rows.mjs" node scripts/check-index-rows.mjs
    run_step "node scripts/check-backlog-claims.mjs" node scripts/check-backlog-claims.mjs
    run_step "node scripts/check-filter-figures.mjs" node scripts/check-filter-figures.mjs
    run_step "node scripts/check-comment-hygiene.mjs" node scripts/check-comment-hygiene.mjs
else
    echo "pre-push: skipping the doc-link, index-row, backlog-claim, filter-figure and comment-hygiene checks (no node on PATH)"
fi

# The diffusion filter's own suite (Plan 0106 Phase 7c) rides the same guard, in
# Python rather than Node and for the same reason: it is standard library only,
# needs no GPU, no weights and no model, and it runs in about a second. It is the
# one part of that feature that can be gated at all - everything downstream of
# the pass-through is a model whose output is not reproducible across machines.
#
# An absent python3 SKIPS with a notice (ADR-0016), exactly as an absent node
# does above, and the `links` job in CI is the backstop under both.
#
# Two groups inside it skip on their own terms and that is correct: the colour
# table needs numpy (CI installs it), and the end-to-end group needs a release
# `shot`, which this hook does not build.
if command -v python3 >/dev/null 2>&1; then
    run_step "python3 tools/sd-filter/test_sd_filter.py" python3 tools/sd-filter/test_sd_filter.py
else
    echo "pre-push: skipping the diffusion-filter suite (no python3 on PATH)"
fi

run_step "cargo fmt --all --check" cargo fmt --all --check
# `--workspace` matches what CI now runs, and is load-bearing since ADR-0072:
# `lmv-core-cabi` sits outside the workspace default-members, so a bare `cargo
# clippy` / `cargo nextest run` silently stops covering the C ABI entirely.
run_step "cargo clippy --workspace --all-targets -- -D warnings" cargo clippy --workspace --all-targets -- -D warnings

# nextest names the skipped binaries itself, on the profile's authority
# ("9 binaries skipped ... via profile.fast.default-filter"), so this step does
# not enumerate them a second time — a hand-written echo of the list is the
# copy that goes stale when the profile changes.
echo "pre-push: skipping the GPU-heavy suites via profile.fast (CI runs them)"
run_step "cargo nextest run -P fast" cargo nextest run --workspace -P fast

echo ""
echo "pre-push: OK"
