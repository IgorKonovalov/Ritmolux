#!/bin/sh
# Pre-push gate (Plan 0032 Phase 3, ADR-0033).
#
# Runs the fast subset of what CI runs, so a broken push costs seconds here
# instead of minutes there. Stops at the first failure and names the step.
#
# NOT run here, by design (ADR-0033 Alternative F): `cargo deny`, doctests,
# Miri, and the coverage job. Those push the gate from tens of seconds into
# minutes, and a gate that hurts gets disabled — at which point it is worth less
# than the fast subset it replaced. They are also the checks least likely to
# break from a local edit. CI runs all of them.
#
# Install (per clone — git will not run a hook from a tracked directory
# without this, so an uninstalled clone silently has no gate):
#
#     git config core.hooksPath .githooks
#
# Bypass once:  git push --no-verify
#
# POSIX sh: runs under Git-for-Windows' bundled shell and macOS sh alike.

set -u

# Suites excluded from the hook's test step, chosen by measurement rather than
# by guess. Warm wall times on the development machine: reactivity 89 s,
# animation 73 s, sanity 46 s, distinctness 41 s, reaction_diffusion 54 s,
# attractor 49 s, golden 25 s. They iterate every shipped preset or scene
# through a real GPU, which is what makes them slow and what makes them CI's
# job. Excluding them took the gate from ~98 s to ~27 s warm.
#
# SINCE ADR-0157 THE EXCLUSION IS NO LONGER TOTAL, and the ~27 s above is the
# figure before that. Three of the nine - animation, reactivity and sanity - now
# run a 24-preset sample unioned back in by the `fast` profile, measured at
# +58.5 s on the development machine (Plan 0146 Phase 7; a smaller runner packs
# it worse). That is bought coverage, not lost speed: before it, the per-phase
# tier rendered none of the preset library at all.
#
# WHICH nine they are is no longer written here. Since ADR-0156 the list is the
# `fast` profile's default-filter in .config/nextest.toml, and this hook, CI's
# `check` job and the `dev` lane's per-phase gate all cite `-P fast`. The
# measured reasoning above stays in this file and is deliberately not copied
# into the toml; only the list moved. Adding or removing a suite is now a
# one-file edit that none of the three consumers can fall out of step on.
#
# CI still runs all of it on every push, but since ADR-0073 it runs these nine
# in ONE job rather than two: `check (windows-latest)` now carries the same
# exclusion this hook does, and `coverage` is the only place they execute on
# Windows. So skipping them locally still costs nothing — but that promise is
# now underwritten by a single CI job rather than by a redundancy between two.
fail() {
    echo ""
    echo "pre-push: FAILED at: $1"
    echo "pre-push: fix it, or bypass this gate with: git push --no-verify"
    exit 1
}

run_step() {
    label="$1"
    shift
    echo "pre-push: $label"
    "$@" || fail "$label"
}

echo "pre-push: running the fast subset (doc links, backlog claims, comment hygiene, reader prose, release tag, translations, sd-filter, studio, fmt, clippy, rustdoc, tests)"

# Cheapest check first, so the cheapest failure is the fastest one. ~50 ms, which
# is why it fits a gate ADR-0033 Alternative F otherwise keeps to the fast subset:
# the budget argument that excludes `cargo deny` and Miri does not reach it.
#
# It is here rather than only in the architect close ceremony because the moment
# a link breaks is a push, not a close: moving a plan into docs/plans/done/
# invalidates every inbound link naming its old path and every `../adrs/` link
# inside it. That went unnoticed across six consecutive closes (74 broken links
# by Plan 0060) precisely because nothing ran at push time.
#
# Node is not otherwise required to build or test this project, so an absent node
# SKIPS with a notice rather than failing the push — the ADR-0016 shape. That is
# a statement about this HOOK, not about the gate: the `links` job in CI runs the
# same check on ubuntu-latest, where Node is always present and it cannot skip.
#
# The backlog-claim gate rides the same guard (Plan 0093 Phase 3, ADR-0108). It
# re-runs the probes docs/design-backlog.md's live entries carry beside their
# claims about this repo — four entries had been falsified and three of those
# carried no verification stamp at all, so a stale entry sends the next reader
# to do work that is already done. Same cost class as the link check: a parse of
# one markdown file plus a bounded number of regex scans.
#
# The filter-figure gate rides it too (Plan 0106 Phase 7e, ADR-0120). It asserts
# that the diffusion filter's cost figures live in docs/diffusion-filter.md and
# nowhere else. Same cost class as the three beside it, and the same history: the
# feature was documented in three files at once, and a correction at Plan 0106's
# close enumerated two of the three copies and missed the third. It checks that
# duplicates do not EXIST rather than that they agree, because the copy that broke
# it was the one outside the list anyone was checking.
#
# The comment-hygiene gate rides it too (Plan 0118 Phase 5, ADR-0127). It rejects
# a relative link in a `.rs` comment and plan-relative narration - the two rot
# classes a script can judge. The links are the reason it is here rather than in
# the close ceremony alone: `check-doc-links.mjs` walks `.md` only, so eleven `.rs`
# links were broken on main with every gate green, and they break at exactly the
# moment a plan moves into docs/plans/done/. Same cost class as the three beside
# it. It says nothing about how LONG a comment is - that judgement is the Mode 4
# review's, per ADR-0127.
#
# The index-row gate rides it too (Plan 0105 Phase 5, ADR-0116). It holds every
# row inside a marked roster region to 320 bytes, because the three index files
# had grown rows that summarize the documents they point at — docs/adrs/README.md
# reached 16 % of the ADR corpus it indexes. Push time is the right moment for the
# same reason the link check is here: the close ceremony writes these rows, and a
# convention alone has already been tried and already failed (Plan 0061 Phase 7b
# archived the plan write-ups, and the section regrew 7.1x in eight days under its
# own "One line per plan" heading). Same cost class again — a walk of the markdown
# tree and a byte count per row.
#
# THAT GATE IS INVOKED TWICE, and the second invocation is not redundant. The
# plain run exits 0 on a tree with no fat row in it and exits 0 on a detector that
# has stopped matching anything, and those two states were indistinguishable at
# all three of its call sites: replacing its row regexes with regexes that match
# nothing reports `0 rows, 0 over cap` and goes green everywhere (backlog 0104).
# `--self-test` is where the assertion lives - the fixture's exact counts, a floor
# on the repository's, and the `file:line  N bytes (cap C)` reporting path, which
# no other run of this gate reaches at all. Same cost class again, two more walks.
#
# The contents-block gate (ADR-0163) rides it too, and it is invoked twice for a
# reason that is NOT the index-row one. `--check` regenerates each block from the
# headings under it and reports drift, so it cannot go quietly green on a detector
# that stopped matching - an empty generated block would not equal a populated
# committed one. What it cannot see is an anchor that is merely PLAUSIBLE:
# check-doc-links.mjs validates paths and deliberately never validates fragments,
# so a wrong slug rule ships silently and every row in every block is wrong
# together. `--self-test` is where that is pinned, against two anchors this
# repository already links.
#
# The reader-prose gate (ADR-0168) is one of the two here whose subject is prose
# rather than structure. It asserts that in
# the documents a reader meets on the site, every citation of a plan or an ADR
# sits inside a markdown link rather than bare in a sentence - the exact inverse
# of what ADR-0127 asks of a `.rs` comment, because those documents address a
# reader who wants to know what a parameter does rather than a session
# reconstructing why a threshold exists. The boundary between the two rules is
# the filename list inside the script, which is also the only place its roster is
# written down - a count of it here would be falsified by every document added. Push time is the right moment for the same reason it is for
# the index-row gate above: the convention alone was tried, has been in CLAUDE.md
# throughout, and is exactly how those documents accumulated 235 bare citations.
# Same cost class again - one file read per document and a regex scan of each.
#
# The release-tag gate (ADR-0203) is the only one whose
# subject is a git ref rather than a file. It asserts that the version the root
# Cargo.toml declares has a tag that exists locally, is ANNOTATED, and sits on
# HEAD's history. Push time is exactly the right moment: `git push --follow-tags`
# sends annotated tags only, so a lightweight tag at the current version is a
# release that this very push will silently fail to start. It is invoked twice
# for the index-row reason - `--self-test` proves in a throwaway repository that
# a missing, a lightweight and an off-history tag each exit 1. CI cannot run the
# offline reading (its checkout carries no tags); it runs `--remote` instead, on a
# push to main. A handful of git calls, plus one `git init` for the self-test.
#
# The translation gate (ADR-0185) is the only one whose
# subject is a second copy nothing can check: no machine here can tell whether a
# Russian page still says what the English one now says. So it splits — a missing
# or malformed `translated-from` stamp is an exit code, because that is
# mechanical, and a source that has moved past its stamp is an advisory row that
# never touches it. Hard-failing on drift would make the Russian slice a hostage
# of every hotkey edit to docs/running.md, on a project with one translator.
# IT IS INVOKED TWICE for the index-row reason and then some: a detector that
# stopped matching reports `0 stamped translation(s)` and goes green here, in CI
# and at the close alike. `--self-test` asserts the four hard-failure shapes
# against the seeded red tree, both stamp widths against a throwaway repository,
# the shallow-clone withholding against a real `--depth 1` clone of it, and the
# site banner's four behaviours — which is also what pins the banner's copy of
# the stamp rule to this one, since the two live in different projects.
#
# The system-count gate rides it too (ADR-0202), and it is the other prose one.
# It rejects a written-out count of the systems - a count token within two words
# of `system` or `systems` - everywhere but the dated records, which are the
# plans, the ADRs and the design backlog. A count goes stale whether or not it is
# right today, so the number is the defect rather than its value: two systems
# landed three days apart and each close found sentences carrying the old total,
# one of them inside an assertion MESSAGE, which no comment lexer sees. Push time
# for the index-row reason again - CLAUDE.md has asked for count-free phrasing
# throughout, and that is exactly how those sentences accumulated. Same cost
# class as the gates beside it: one file read per tracked document and a regex
# scan of each. `count-allow: <why>` on the line is the escape, and the reason is
# required.
#
# The roster's own gate closes the block (ADR-0217), and its subject is this file
# rather than a document: the list above is one of THREE copies - the hook, CI's
# `links` job and the conductor's `defaultGate()` - and nothing held them equal,
# so the third fell behind twice. scripts/gates.manifest.mjs is now the roster,
# the conductor imports it, and this gate asserts that the `run_step` lines above
# and CI's `run:` lines are its projection for each of them, in order. Cheapest
# cost class here: two file reads and a regex scan of each. It is invoked twice
# for the index-row reason - `--self-test` seeds a gate missing from a carrier, a
# gate a carrier runs that the roster does not, and a gate in the wrong position,
# the last of which is what a set comparison reports clean. It asserts
# invocations and ORDER and never the `if:` conditions a carrier attaches, and it
# does not read the English notice below - which will drift, and says less than
# it should when it does.
if command -v node >/dev/null 2>&1; then
    run_step "node scripts/check-doc-links.mjs" node scripts/check-doc-links.mjs
    run_step "node scripts/check-index-rows.mjs" node scripts/check-index-rows.mjs
    run_step "node scripts/check-index-rows.mjs --self-test" node scripts/check-index-rows.mjs --self-test
    run_step "node scripts/check-backlog-claims.mjs" node scripts/check-backlog-claims.mjs
    run_step "node scripts/check-filter-figures.mjs" node scripts/check-filter-figures.mjs
    run_step "node scripts/check-comment-hygiene.mjs" node scripts/check-comment-hygiene.mjs
    run_step "node scripts/toc.mjs --check" node scripts/toc.mjs --check
    run_step "node scripts/toc.mjs --self-test" node scripts/toc.mjs --self-test
    run_step "node scripts/check-reader-prose.mjs" node scripts/check-reader-prose.mjs
    run_step "node scripts/check-release-tag.mjs" node scripts/check-release-tag.mjs
    run_step "node scripts/check-release-tag.mjs --self-test" node scripts/check-release-tag.mjs --self-test
    run_step "node scripts/check-translations.mjs" node scripts/check-translations.mjs
    run_step "node scripts/check-translations.mjs --self-test" node scripts/check-translations.mjs --self-test
    run_step "node scripts/check-system-counts.mjs" node scripts/check-system-counts.mjs
    run_step "node scripts/check-gate-carriers.mjs" node scripts/check-gate-carriers.mjs
    run_step "node scripts/check-gate-carriers.mjs --self-test" node scripts/check-gate-carriers.mjs --self-test
else
    echo "pre-push: skipping the doc-link, index-row, backlog-claim, filter-figure, comment-hygiene, reader-prose, contents-block, release-tag, translation, system-count and gate-roster checks (no node on PATH)"
fi

# The diffusion filter's own suite (Plan 0106 Phase 7c) rides the same guard, in
# Python rather than Node and for the same reason: it is standard library only,
# needs no GPU, no weights and no model, and it runs in about a second. It is the
# one part of that feature that can be gated at all - everything downstream of
# the pass-through is a model whose output is not reproducible across machines.
#
# An absent python3 SKIPS with a notice (ADR-0016), exactly as an absent node
# does above, and the `links` job in CI is the backstop under both.
#
# Two groups inside it skip on their own terms and that is correct: the colour
# table needs numpy (CI installs it), and the end-to-end group needs a release
# `shot`, which this hook does not build.
if command -v python3 >/dev/null 2>&1; then
    run_step "python3 tools/sd-filter/test_sd_filter.py" python3 tools/sd-filter/test_sd_filter.py
else
    echo "pre-push: skipping the diffusion-filter suite (no python3 on PATH)"
fi

# The studio's gate (Plan 0159, ADR-0178): typecheck, lint and the Vitest suite
# for studio/, which is TypeScript and touches no cargo target at all.
#
# It rides a guard on studio/node_modules rather than on a command, unlike the
# node and python3 guards above: `npm` being on PATH says nothing about whether
# THIS clone has installed the studio's dependency tree, and `npm ci` from a
# hook is not a thing a gate may do - it is a minutes-long network install.
# So an uninstalled clone SKIPS with a notice, in ADR-0016's shape, and the CI
# `studio` job is the backstop that cannot skip, exactly as the `links` job is
# for the Node checks above.
#
# It costs 15.2 s warm on the development machine - typecheck 7.7 s, lint 2.6 s,
# tests 4.6 s - against the ~27 s the rest of this hook took before ADR-0157's
# preset sample. That is the largest single addition this gate has taken, and it
# is bought coverage rather than lost speed: nothing else here reads studio/ at
# all, and a red typecheck there is invisible to every cargo step below.
#
# `npm --prefix` rather than a `cd`: this hook runs from the repository root and
# a step that changes directory would leak into the cargo steps beneath it.
if [ -d studio/node_modules ]; then
    run_step "npm --prefix studio run typecheck" npm --prefix studio run typecheck
    run_step "npm --prefix studio run lint" npm --prefix studio run lint
    run_step "npm --prefix studio test" npm --prefix studio test
else
    echo "pre-push: skipping the studio's typecheck, lint and tests (no studio/node_modules; run: npm --prefix studio ci)"
fi

run_step "cargo fmt --all --check" cargo fmt --all --check
# `--workspace` matches what CI now runs, and is load-bearing since ADR-0072:
# `rlx-core-cabi` sits outside the workspace default-members, so a bare `cargo
# clippy` / `cargo nextest run` silently stops covering the C ABI entirely.
run_step "cargo clippy --workspace --all-targets -- -D warnings" cargo clippy --workspace --all-targets -- -D warnings

# rustdoc over the engine's public surface, so a broken or private intra-doc link
# fails here rather than in CI's `cargo doc --workspace` job. Scoped to rlx-core so a
# warm engine edit costs no more here than the clippy step above (the timings are in
# Plan 0177 Phase 7 and the ci.yml comment), and it still fails on a public item
# linking a private one. `--features text` documents the rlx-core the
# workspace builds: the standalone turns that feature on, and without it a link to
# the feature-gated `aux_target` does not resolve. `standalone`'s public items are
# NOT covered here; CI's job is the only place they are documented.
run_step "cargo doc -p rlx-core --no-deps --features text (RUSTDOCFLAGS=-D warnings)" env "RUSTDOCFLAGS=-D warnings" cargo doc -p rlx-core --no-deps --features text

# nextest names what it skipped itself, on the profile's authority, so this step
# does not enumerate it a second time - a hand-written echo of the list is the
# copy that goes stale when the profile changes, which is exactly what happened
# to the "9 binaries skipped" this comment used to quote. Since ADR-0157 the
# skip is partly per TEST rather than per binary, so read nextest's own line.
echo "pre-push: deferring most of the GPU-heavy suites via profile.fast, minus the preset sample (CI runs the rest)"
run_step "cargo nextest run -P fast" cargo nextest run --workspace -P fast

echo ""
echo "pre-push: OK"
